# Modo mantenimiento: "true" muestra la página de mantenimiento, "false" muestra el sitio
VITE_MANTENIMIENTO=false

# Texto opcional que se muestra en la página de mantenimiento (si está vacío se usa el texto por defecto)
VITE_MANTENIMIENTO_MENSAJE=

# Clave opcional para el mapa de lugares de Arica (Maps Embed API)
VITE_GOOGLE_MAPS_API_KEY=
